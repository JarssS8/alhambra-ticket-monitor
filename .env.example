# CONFIGURACIÓN GENERAL
# Intervalo de verificación en segundos (default: 300 = 5 minutos)
CHECK_INTERVAL=300

# TELEGRAM (opcional)
# Obtén el token de BotFather: https://t.me/BotFather
# Obtén el chat ID escribiendo /start a https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DISCORD (opcional)
# Crea un webhook en tu servidor: Settings > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456/abc...
# Tu ID de Discord (para ser mencionado cuando bajan precios)
DISCORD_USER_ID=156445717068644352

# EMAIL (opcional)
# Ejemplo con Gmail: Usa contraseña de app (no contraseña normal)
# https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
EMAIL_RECIPIENT=destinatario@ejemplo.com
